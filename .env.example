# =============================================================================
#  Örnek yapılandırma dosyası
# =============================================================================
#  Bu dosyayı `.env` adıyla kopyalayıp kendi değerlerinizle doldurun:
#
#      cp .env.example .env          (Windows: copy .env.example .env)
#
#  `.env` dosyası .gitignore içindedir ve ASLA depoya gönderilmez —
#  içinde veritabanı parolası bulunur.
#
#  Buradaki her satır silinebilir. Silinen ayar için kodda tanımlı varsayılan
#  değer kullanılır (bkz. app/config/settings.py).
# =============================================================================


# =============================================================================
# 1) VERİ KAYNAĞI
# =============================================================================
# Sistemin ihale verilerini nereden okuyacağı. Uygulamanın geri kalanı bu
# seçimden habersizdir; iki arka uç da aynı arayüzü uygular.
#
#   sqlite   = yerel bir ekap.db dosyası. Kurulum gerektirmez, denemek için ideal.
#   postgres = canlı veritabanı sunucusu. SALT OKUMA yapılır, hiçbir şey yazılmaz.
DATA_BACKEND=sqlite

# --- sqlite arka ucu ---
# Yerel veritabanı dosyanızın yolu. Boş bırakırsanız proje içindeki
# data/ekap.db kullanılır.
# SQLITE_YOLU=data/ekap.db

# --- postgres arka ucu ---
# DATA_BACKEND=postgres yaptıysanız doldurun.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=


# =============================================================================
# 2) OLLAMA (yerel dil modeli sunucusu)
# =============================================================================
# Modeller kendi bilgisayarınızda çalışır; hiçbir veri dışarı çıkmaz.
# Kurulum: https://ollama.com
OLLAMA_HOST=http://localhost:11434

# Metinleri vektöre çeviren model (benzer içerik araması için kullanılır).
EMBEDDING_MODEL=bge-m3

# Embedding'in nereden alınacağı:
#   ollama                -> Ollama'daki bge-m3 (varsayılan, ek indirme yok)
#   sentence-transformers -> BAAI/bge-m3 (~2.2 GB indirir, toplu işlemde daha hızlı)
#   fake                  -> model gerektirmeyen sahte vektör. SADECE TEST İÇİN.
EMBEDDING_BACKEND=ollama


# =============================================================================
# 3) KARAR MODELİ
# =============================================================================
# Kararı veren ana model.
#   qwen3:4b  -> VARSAYILAN. ~4 GB VRAM yeter, hızlıdır, ölçümlerde yeterli isabet verir.
#   qwen3:8b  -> Daha isabetli ama ~8 GB VRAM ister ve belirgin biçimde yavaştır.
# Kullanmadan önce indirin:  ollama pull qwen3:4b
BIRINCIL_MODEL=qwen3:4b

# OPSİYONEL ikinci görüş: ana model kararından emin değilse ikinci bir modele danışır.
# BOŞ BIRAKILIRSA KAPALIDIR ve önerilen budur. Tek GPU'lu makinelerde açmayın —
# iki model sırayla belleğe yüklenip boşaltılır, her geçiş saniyeler kaybettirir.
IKINCIL_MODEL=
IKINCIL_GUVEN_ESIGI=0.75

# Bir model isteğinin cevap bekleme süresi (saniye).
# GPU ile 180 fazlasıyla yeterlidir (ihale başına ölçülen süre 64-76 sn).
# Sadece CPU ile çalışıyorsanız 3600 yapın; aynı işlem 10-40 dakika sürebilir.
LLM_TIMEOUT_SN=180

# Modelin bir seferde okuyabileceği metin penceresi (token).
NUM_CTX=8192

# qwen3 "düşünme" (reasoning) modu:
#   (boş) -> Ollama'ya hiç gönderilmez, modelin kendi varsayılanı geçerli. ÖNERİLEN.
#   false -> kapalı. Daha hızlıdır ama ölçümde isabet düştü.
#   true  -> açık ve üretilen düşünce metni sonuç dosyasına kaydedilir.
LLM_DUSUNME=

# Sabit rastgelelik tohumu. Aynı girdiye aynı cevabı almak için gereklidir.
# Karşılaştırmalı ölçüm yaparken DEĞİŞTİRMEYİN, yoksa koşular kıyaslanamaz.
LLM_SEED=42

# Modelin GPU'ya yüklenecek katman sayısı.
#   (boş) -> Ollama kendi karar verir. Normal kullanım budur.
#   0     -> tamamen CPU. Çok yavaştır; yalnızca GPU'suz sunucu senaryosunu
#            ölçmek için kullanın ve LLM_TIMEOUT_SN'i mutlaka yükseltin.
# LLM_NUM_GPU=


# =============================================================================
# 4) BENZER İÇERİK ARAMA (retrieval)
# =============================================================================
# Prompt'a en fazla kaç iş paketi ve kaç geçmiş örnek konacağı.
RETRIEVAL_PAKET_K=5
RETRIEVAL_ORNEK_K=3

# Bir iş paketinin "ilgili" sayılması için gereken en düşük benzerlik.
#   0.0  = eşik yok (varsayılan)
#   0.47 = önerilen. Ölçümde rastgele ihalelerin %59'unu eler ve hiçbir uygun
#          ihaleyi kaybettirmez (uygun ihalelerin en düşük skoru 0.5149'du).
# Yumuşak uygulanır: eşiği geçen paket yoksa model yine çağrılır, sadece
# prompt'a asılsız bir "ilgili paketler" listesi konmaz.
RETRIEVAL_MIN_SKOR=0.0

# En yakın paketle benzerlik bu değerin altındaysa model HİÇ çağrılmaz, ihale
# doğrudan elenir. Binlerce ihalelik toplu taramalarda 0.44 önerilir; büyük
# hız kazancı sağlar. DİKKAT: bu bir eleme kapısıdır, yüksek ayarlarsanız
# uygun ihaleler hiç incelenmeden elenir. 0.0 = kapalı.
# SERT_ON_FILTRE_SKORU=0.0

# Model "belirsiz" dediğinde, ürettiği ilgi skoru bu değerin altındaysa karar
# "uygun_degil"e çevrilir. Model "hayır" demekten kaçınıp "bilmiyorum"a
# sığınma eğiliminde olduğu için aday listesi gereksiz şişiyor.
#   0.0  = kapalı (varsayılan)
#   0.48 = önerilen. 60 etiketli ihalede tam isabet %70'ten %92'ye çıktı ve
#          hiçbir uygun ihale kaybedilmedi.
BELIRSIZ_NETLESTIRME_ESIGI=0.0


# =============================================================================
# 5) DENEYSEL İYİLEŞTİRME ANAHTARLARI
# =============================================================================
# HEPSİ VARSAYILAN KAPALI. Her birinin ne yaptığı app/config/settings.py
# içinde ayrıntılı açıklanmıştır.
#
# ÖNEMLİ: Bunları TEK TEK açıp ölçün. Aynı anda birkaçını açarsanız sonucun
# hangi değişiklikten geldiğini ayırt edemezsiniz.

# Model, kendisine sunulan listede olmayan bir paket adı uydurursa yakala.
PAKET_DOGRULA=false

# İhalenin tüm OKAS kodları açıkça kapsam dışıysa "kanıt yetersiz" uyarısını verme.
OKAS_VETOSU=false

# Benzerliği prompt'ta sayı yerine nitel etiketle göster ("yakınlık: orta").
NITEL_YAKINLIK=false

# Paketlerin negatif terimlerini metinde KOD ile ara, bulduğunu alıntıyla sun.
NEGATIF_DOGRULA=false

# Çıktı şemasına kategorik "faaliyet_ortusmesi" alanı ekle.
FAALIYET_ORTUSMESI=false

# İhale başlığında tanıdık bir terim geçiyorsa "kanıt yetersiz" uyarısını verme.
B1_ALAN_TERIMI_ISTISNASI=false

# En yakın paketlerin hepsi genel/destekleyici paketse bunu modele bildir.
DESTEKLEYICI_PAKET_KURALI=false


# =============================================================================
# 6) AŞAMA 2 (YETERLİLİK KONTROLÜ)
# =============================================================================
# false yaparsanız yalnızca Aşama 1 (kapsam kararı) çalışır.
# NOT: Aşama 2, şirket kapasite verisi (iş deneyim belgeleri, sertifikalar,
# personel) girilmeden anlamlı sonuç üretemez — bkz. README "Bilinen sınırlar".
ASAMA2_CALISSIN=true
