# =============================================================================
# EKAP İSBAK İhale Analiz Servisi – Ortam Değişkenleri Şablonu
# =============================================================================
# Bu dosya .env.example'dır. Gerçek ortam dosyanızı oluşturmak için:
#   cp .env.example .env
# Ardından .env içindeki değerleri kendi ortamınıza göre düzenleyin.
# UYARI: .env dosyasını asla Git'e eklemeyin. Bu şablon (.env.example) güvenlidir.
# =============================================================================


# -----------------------------------------------------------------------------
# UYGULAMA GENEL AYARLARI (Zorunlu değil – varsayılan değerler mevcuttur)
# -----------------------------------------------------------------------------
APP_NAME=EKAP İSBAK Tek Modelli RAG
APP_ENV=development
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# POSTGRESQL VERİTABANI BAĞLANTISI (Zorunlu – gerçek değerlerle doldurun)
# -----------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ekap_db
DATABASE_USER=ekap_user
DATABASE_PASSWORD=your_password_here


# -----------------------------------------------------------------------------
# OLLAMA LLM SUNUCUSU (Zorunlu – Qwen modelinin çalıştığı adres)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434


# -----------------------------------------------------------------------------
# MODEL AYARLARI (Zorunlu değil – yalnızca varsayılanı değiştirmek istiyorsanız)
# Dikkat: Yalnızca izin verilen model adları kabul edilir.
# İzin verilen Qwen modeli   : qwen3.5:4b-q4_K_M
# İzin verilen Gemma modeli  : gemma4:e2b-it-q4_K_M
# -----------------------------------------------------------------------------
QWEN_MODEL=qwen3.5:4b-q4_K_M
# GEMMA_MODEL=gemma4:e2b-it-q4_K_M
# PHI_MODEL=phi4-mini:latest


# -----------------------------------------------------------------------------
# OLLAMA ZAMAN AŞIMI VE YENIDEN DENEME AYARLARI (İsteğe bağlı)
# -----------------------------------------------------------------------------
# OLLAMA_CONNECT_TIMEOUT_SECONDS=10
# OLLAMA_DECISION_TIMEOUT_SECONDS=600
# OLLAMA_MAX_ATTEMPTS=2
# OLLAMA_RETRY_BACKOFF_SECONDS=1.0


# -----------------------------------------------------------------------------
# MODEL BAĞLAM VE TAHMIN UZUNLUĞU (İsteğe bağlı)
# -----------------------------------------------------------------------------
# QWEN_DECISION_NUM_CTX=12288
# QWEN_DECISION_NUM_PREDICT=1000
# GEMMA_DECISION_NUM_CTX=12288
# GEMMA_DECISION_NUM_PREDICT=1100


# -----------------------------------------------------------------------------
# OLLAMA PARALEL İŞLEM AYARLARI (İsteğe bağlı)
# -----------------------------------------------------------------------------
# OLLAMA_NUM_THREAD=4
# OLLAMA_NUM_BATCH=32


# -----------------------------------------------------------------------------
# GÖMME (EMBEDDING) AYARLARI (İsteğe bağlı)
# -----------------------------------------------------------------------------
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu
# EMBEDDING_BATCH_SIZE=4
# EMBEDDING_NORMALIZE=true


# -----------------------------------------------------------------------------
# JSON DÜZELTME AYARLARI (İsteğe bağlı)
# -----------------------------------------------------------------------------
# MAX_JSON_CORRECTIONS=1


# -----------------------------------------------------------------------------
# BAĞLAM KARAKTER SINIRI AYARLARI (İsteğe bağlı)
# -----------------------------------------------------------------------------
# MAX_TENDER_CONTEXT_CHARS=12000
# MAX_COMPANY_CONTEXT_CHARS=5000


# -----------------------------------------------------------------------------
# DEPOLAMA YOLLARI (İsteğe bağlı – göreli ya da mutlak yol)
# -----------------------------------------------------------------------------
# QDRANT_PATH=storage/qdrant
# MODEL_CACHE_PATH=storage/model_cache
# OUTPUT_DIR=outputs
# REPORT_DIR=reports
# LOG_DIR=logs
