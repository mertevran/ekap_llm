# PostgreSQL kaynak bağlantısı
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=ekap_db
DATABASE_USER=ekap_reader
DATABASE_PASSWORD=degistirin
DATABASE_SSLMODE=prefer
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=60000
DATABASE_APPLICATION_NAME=ekap-isbak-decision

# Tek model ve Ollama çalışma ayarları
QWEN_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_THREAD=12
OLLAMA_NUM_BATCH=32
OLLAMA_DECISION_TIMEOUT_SECONDS=3600
OLLAMA_MAX_ATTEMPTS=3
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# Güvenlik kapıları
AUTOMATIC_POSITIVE_DECISIONS_ENABLED=false
MAX_RUNTIME_SWAP_GROWTH_MB=512
